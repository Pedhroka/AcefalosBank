<UserControl x:Class="MiniBanco.Ui.Views.CriarContaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiniBanco.Ui.Recursos">
    <StackPanel>
        <TextBlock Text="Criar conta" Style="{StaticResource TituloPagina}"/>
        <TextBlock Text="Cadastre uma nova conta com número, titular e saldo inicial." Style="{StaticResource SubtituloPagina}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardPadrao}">
                <StackPanel>
                    <TextBlock Text="Dados da conta" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Preencha todos os campos para criar a conta." Style="{StaticResource TextoSecundario}"/>

                    <TextBlock Text="Número da conta" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtNumero" Style="{StaticResource CampoTexto}" local:Dica.Texto="Ex.: 1006"/>
                    <TextBlock Text="Informe um número inteiro ainda não cadastrado." Style="{StaticResource TextoAjuda}"/>

                    <TextBlock Text="Titular" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtTitular" Style="{StaticResource CampoTexto}" local:Dica.Texto="Ex.: Maria Silva"/>

                    <TextBlock Text="Saldo inicial" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtSaldo" Style="{StaticResource CampoTexto}" local:Dica.Texto="Ex.: R$ 0,00"/>
                    <TextBlock Text="O saldo inicial pode ser zero." Style="{StaticResource TextoAjuda}"/>

                    <Border Style="{StaticResource Separador}"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Criar conta" Style="{StaticResource BotaoPrimario}" Click="Criar_Click"/>
                        <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" Click="Cancelar_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtMensagem" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardInfo}" Margin="24,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Uma conta, um número" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource CorPrimaria}" Margin="0,0,0,8"/>
                    <TextBlock Text="Cada conta guarda o número, o nome do titular e o saldo em reais."
                               Style="{StaticResource TextoSecundario}" Margin="0,0,0,24"/>
                    <TextBlock Text="✓  O número da conta deve ser único." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  O titular identifica a conta." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  O saldo inicial não pode ser negativo." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
