<UserControl x:Class="MiniBanco.Ui.Views.ListarContasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Listar contas" Style="{StaticResource TituloPagina}"/>
        <TextBlock Text="Veja todas as contas cadastradas e seus saldos atuais." Style="{StaticResource SubtituloPagina}"/>

        <Border Style="{StaticResource CardPadrao}">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Contas cadastradas" Style="{StaticResource TituloCard}"/>
                        <TextBlock x:Name="TxtQuantidade" Style="{StaticResource TextoSecundario}"/>
                    </StackPanel>
                    <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Atualizar_Click"/>
                </Grid>

                <DataGrid x:Name="Tabela"
                          Margin="0,24,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          RowHeight="48"
                          ColumnHeaderHeight="44"
                          FontSize="15"
                          BorderBrush="{StaticResource CorBorda}"
                          BorderThickness="1"
                          Background="{StaticResource CorFundo}"
                          RowBackground="{StaticResource CorFundo}"
                          AlternatingRowBackground="{StaticResource CorPainelInfo}"
                          Foreground="{StaticResource CorTexto}"
                          SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource CorPainelInfo}"/>
                            <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="1*"/>
                        <DataGridTextColumn Header="Titular" Binding="{Binding Titular}" Width="3*"/>
                        <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat={}{0:C}}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtVazio" Text="Nenhuma conta cadastrada."
                           Style="{StaticResource TextoSecundario}" Margin="0,24,0,0" Visibility="Collapsed"/>

                <Border Style="{StaticResource Separador}"/>
                <TextBlock Text="Número único • Titular da conta • Saldo em reais" Style="{StaticResource TextoAjuda}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
