<UserControl x:Class="MiniBanco.Ui.Views.MenuPrincipalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MiniBanco.Ui.Views">
    <StackPanel>
        <TextBlock Text="Menu principal" Style="{StaticResource TituloPagina}"/>
        <TextBlock Text="Escolha o que você deseja fazer na sua conta." Style="{StaticResource SubtituloPagina}"/>

        <Border Background="{StaticResource CorPrimaria}" CornerRadius="12" Padding="32" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="O essencial para gerenciar sua conta." FontSize="20" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="Consulte o saldo, faça depósitos e saques e acompanhe seu extrato."
                           FontSize="14" Foreground="White" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <UniformGrid Columns="2" Margin="-12,12,-12,0">
            <Button Style="{StaticResource CardAcao}" Tag="{x:Static views:Tela.Saldo}" Click="Card_Click">
                <StackPanel>
                    <TextBlock Text="Consultar saldo" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Veja o saldo disponível da sua conta." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardAcao}" Tag="{x:Static views:Tela.Depositar}" Click="Card_Click">
                <StackPanel>
                    <TextBlock Text="Depositar" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Envie um valor da sua conta para outra conta." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardAcao}" Tag="{x:Static views:Tela.Sacar}" Click="Card_Click">
                <StackPanel>
                    <TextBlock Text="Sacar" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Retire um valor dentro do saldo disponível." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardAcao}" Tag="{x:Static views:Tela.Extrato}" Click="Card_Click">
                <StackPanel>
                    <TextBlock Text="Mostrar extrato" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Veja todas as entradas e saídas com data e saldo." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </StackPanel>
</UserControl>
