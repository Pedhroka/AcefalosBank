<UserControl x:Class="MiniBanco.Ui.Views.SacarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiniBanco.Ui.Recursos">
    <StackPanel>
        <TextBlock Text="Sacar" Style="{StaticResource TituloPagina}"/>
        <TextBlock Text="Retire um valor respeitando o saldo disponível da conta." Style="{StaticResource SubtituloPagina}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardPadrao}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados do saque" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Informe a conta e o valor que deseja sacar." Style="{StaticResource TextoSecundario}"/>

                    <TextBlock Text="Número da conta" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtNumero" Style="{StaticResource CampoTexto}" local:Dica.Texto="Ex.: 1003"/>
                    <TextBlock Text="A conta deve estar cadastrada no Acefalos Bank." Style="{StaticResource TextoAjuda}"/>

                    <TextBlock Text="Valor" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtValor" Style="{StaticResource CampoTexto}" local:Dica.Texto="Ex.: R$ 150,00"/>
                    <TextBlock Text="Informe um valor maior que zero." Style="{StaticResource TextoAjuda}"/>

                    <Border Style="{StaticResource Separador}"/>

                    <Button Content="Sacar" Style="{StaticResource BotaoPrimario}" HorizontalAlignment="Left" Click="Sacar_Click"/>

                    <TextBlock x:Name="TxtMensagem" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardInfo}" Margin="24,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dentro do saldo disponível" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource CorPrimaria}" Margin="0,0,0,8"/>
                    <TextBlock Text="Após o saque, o resultado apresenta o novo saldo da conta."
                               Style="{StaticResource TextoSecundario}" Margin="0,0,0,24"/>
                    <TextBlock Text="✓  O valor do saque deve ser positivo." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  O valor não pode ultrapassar o saldo." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  Confira o número antes de sacar." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
