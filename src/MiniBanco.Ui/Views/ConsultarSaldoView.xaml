<UserControl x:Class="MiniBanco.Ui.Views.ConsultarSaldoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Consultar saldo" Style="{StaticResource TituloPagina}"/>
        <TextBlock Text="Veja o saldo disponível da sua conta." Style="{StaticResource SubtituloPagina}"/>

        <Border Style="{StaticResource CardPadrao}" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Titular" FontSize="12" Foreground="{StaticResource CorTextoSecundario}"/>
                        <TextBlock x:Name="TxtTitular" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource CorTexto}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource PilulaCabecalho}" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="TxtConta" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource CorPrimaria}"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Separador}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Saldo disponível" FontSize="14" Foreground="{StaticResource CorTextoSecundario}"/>
                        <TextBlock x:Name="TxtSaldo" Style="{StaticResource ValorDestaque}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button x:Name="BtnOlho" Grid.Column="1" Style="{StaticResource BotaoSecundario}"
                            Width="48" Height="48" MinWidth="48" Padding="0"
                            VerticalAlignment="Center" ToolTip="Mostrar saldo" Click="Olho_Click">
                        <TextBlock x:Name="TxtIconeOlho" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Text="&#xE890;" Foreground="{StaticResource CorTexto}"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
