<UserControl x:Class="MiniBanco.Ui.Views.DepositarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Depositar" Style="{StaticResource TituloPagina}"/>
        <TextBlock Text="Adicione um valor ao saldo de uma conta cadastrada." Style="{StaticResource SubtituloPagina}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardPadrao}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados do depósito" Style="{StaticResource TituloCard}"/>
                    <TextBlock Text="Informe a conta e o valor que será depositado." Style="{StaticResource TextoSecundario}"/>

                    <TextBlock Text="Número da conta" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtNumero" Style="{StaticResource CampoTexto}"/>
                    <TextBlock Text="A conta deve estar cadastrada no Mini-Banco." Style="{StaticResource TextoAjuda}"/>

                    <TextBlock Text="Valor" Style="{StaticResource RotuloCampo}"/>
                    <TextBox x:Name="TxtValor" Style="{StaticResource CampoTexto}"/>
                    <TextBlock Text="Informe um valor maior que zero." Style="{StaticResource TextoAjuda}"/>

                    <Border Style="{StaticResource Separador}"/>

                    <Button Content="Depositar" Style="{StaticResource BotaoPrimario}" HorizontalAlignment="Left" Click="Depositar_Click"/>

                    <TextBlock x:Name="TxtMensagem" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardInfo}" Margin="24,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Valor somado ao saldo" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource CorPrimaria}" Margin="0,0,0,8"/>
                    <TextBlock Text="Após o depósito, o resultado apresenta o novo saldo da conta."
                               Style="{StaticResource TextoSecundario}" Margin="0,0,0,24"/>
                    <TextBlock Text="✓  O valor do depósito deve ser positivo." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  Confira o número antes de depositar." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                    <TextBlock Text="✓  O saldo é atualizado após a operação." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
