<Window x:Class="MiniBanco.Ui.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acefalos Bank"
        Width="520" Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}">
    <Grid Margin="48">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Border Width="40" Height="40" Background="{StaticResource CorPrimaria}" CornerRadius="8">
                    <TextBlock Text="AB" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Acefalos Bank" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource CorTexto}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <ContentControl x:Name="Conteudo"/>
        </StackPanel>
    </Grid>
</Window>
