<Window x:Class="MiniBanco.Ui.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acefalos Bank"
        Width="980" Height="720"
        MinWidth="980" MinHeight="720"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Painel de marca -->
        <Border Background="{StaticResource CorPrimaria}" Padding="48">
            <Grid>
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Width="44" Height="44" Background="White" CornerRadius="10">
                        <TextBlock Text="AB" Foreground="{StaticResource CorPrimaria}" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Acefalos Bank" FontSize="22" FontWeight="Bold" Foreground="White"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Sua conta, sob seu controle." FontSize="30" FontWeight="SemiBold"
                               Foreground="White" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Consulte o saldo, faça depósitos e saques e acompanhe cada movimentação no seu extrato."
                               FontSize="15" Foreground="White" Opacity="0.85" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área do formulário -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="Conteudo" Width="380" Margin="48"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</Window>
