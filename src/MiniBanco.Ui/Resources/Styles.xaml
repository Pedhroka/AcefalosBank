<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MiniBanco.Ui.Recursos">

    <!-- Cores -->
    <Color x:Key="CorFundoCor">#E1E6D0</Color>
    <Color x:Key="CorPainelInfoCor">#CBD8C2</Color>
    <Color x:Key="CorPrimariaCor">#0F4C4A</Color>
    <Color x:Key="CorTextoCor">#1F2A24</Color>
    <Color x:Key="CorTextoSecundarioCor">#4A5A52</Color>
    <Color x:Key="CorBordaCor">#9FC3B0</Color>
    <Color x:Key="CorErroCor">#B42318</Color>
    <Color x:Key="CorSucessoCor">#1E7B4F</Color>

    <SolidColorBrush x:Key="CorFundo" Color="{StaticResource CorFundoCor}"/>
    <SolidColorBrush x:Key="CorPainelInfo" Color="{StaticResource CorPainelInfoCor}"/>
    <SolidColorBrush x:Key="CorPrimaria" Color="{StaticResource CorPrimariaCor}"/>
    <SolidColorBrush x:Key="CorTexto" Color="{StaticResource CorTextoCor}"/>
    <SolidColorBrush x:Key="CorTextoSecundario" Color="{StaticResource CorTextoSecundarioCor}"/>
    <SolidColorBrush x:Key="CorBorda" Color="{StaticResource CorBordaCor}"/>
    <SolidColorBrush x:Key="CorErro" Color="{StaticResource CorErroCor}"/>
    <SolidColorBrush x:Key="CorSucesso" Color="{StaticResource CorSucessoCor}"/>
    <SolidColorBrush x:Key="CorBotaoTexto" Color="White"/>

    <CornerRadius x:Key="RaioPadrao">8</CornerRadius>
    <CornerRadius x:Key="RaioCard">12</CornerRadius>

    <!-- Tipografia -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SubtituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
        <Setter Property="Margin" Value="0,0,0,32"/>
    </Style>

    <Style x:Key="TituloCard" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
    </Style>

    <Style x:Key="RotuloCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Margin" Value="0,20,0,8"/>
    </Style>

    <Style x:Key="TextoAjuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="TextoMensagemErro" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CorErro}"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <Style x:Key="TextoMensagemSucesso" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CorSucesso}"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <Style x:Key="ValorDestaque" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}"/>
    </Style>

    <!-- Campo de texto -->
    <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Background" Value="{StaticResource CorFundo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borda"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RaioPadrao}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="Dica"
                                       Text="{Binding (local:Dica.Texto), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource CorTextoSecundario}"
                                       Opacity="0.7"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Dica" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource CorPrimaria}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borda" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão primário -->
    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CorBotaoTexto}"/>
        <Setter Property="Background" Value="{StaticResource CorPrimaria}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borda"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RaioPadrao}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borda" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borda" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão secundário -->
    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
    </Style>

    <!-- Botão de texto (ex.: Sair) -->
    <Style x:Key="BotaoTexto" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Item do menu lateral -->
    <Style x:Key="ItemMenu" TargetType="RadioButton">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fundo"
                            Background="Transparent"
                            CornerRadius="{StaticResource RaioPadrao}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPainelInfo}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPainelInfo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card de ação (menu principal) -->
    <Style x:Key="CardAcao" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borda"
                            Background="{StaticResource CorFundo}"
                            BorderBrush="{StaticResource CorBorda}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RaioCard}"
                            Padding="24">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borda" Property="Background" Value="{StaticResource CorPainelInfo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cards -->
    <Style x:Key="CardPadrao" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorFundo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RaioCard}"/>
        <Setter Property="Padding" Value="32"/>
    </Style>

    <Style x:Key="CardInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorPainelInfo}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RaioCard}"/>
        <Setter Property="Padding" Value="32"/>
    </Style>

    <Style x:Key="PilulaCabecalho" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorPainelInfo}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>

    <Style x:Key="Separador" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CorBorda}"/>
        <Setter Property="Margin" Value="0,24"/>
    </Style>

</ResourceDictionary>
